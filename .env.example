# ==============================================================================
# Adaptive Technical Viva & Oral Screener - Environment Configuration Example
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Application Information
PROJECT_NAME="Adaptive Technical Viva & Oral Screener"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# API Configuration
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated list or JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501", "http://localhost:8000"]

# MongoDB Configuration (PyMongo Asynchronous API)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="adaptive_viva_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL="INFO"
