from conftest import answer, start


def test_good_answer_scores_100_and_is_labelled_basic(client):
    s = start(client)
    r = answer(client, s["session_id"], s["question"], good=True)
    assert r.status_code == 200
    body = r.json()
    assert body["score"] == 100 and body["max_score"] == 100
    assert body["mode"] == "basic" and "not AI" in body["source"]
    assert body["missing_concepts"] == [] and body["attempt_number"] == 1


def test_bad_answer_scores_0_with_missing_concepts(client):
    s = start(client)
    body = answer(client, s["session_id"], s["question"], good=False).json()
    assert body["score"] == 0 and len(body["missing_concepts"]) == 2
    assert any("Revise" in x for x in body["suggestions"])


def test_empty_answer_rejected(client):
    s = start(client)
    r = client.post("/session/evaluate", json={"session_id": s["session_id"],
                                               "question_id": s["question"]["id"], "answer": "   "})
    assert r.status_code == 422 and "empty" in r.json()["detail"].lower()


def test_invalid_session_and_question_ids(client):
    s = start(client)
    r = client.post("/session/evaluate", json={"session_id": "nope", "question_id": 1, "answer": "x"})
    assert r.status_code == 404
    r = client.post("/session/evaluate", json={"session_id": s["session_id"], "question_id": 424242, "answer": "x"})
    assert r.status_code == 404
    other = next(i for i in range(1, 10) if i != s["question"]["id"])    # real question, but not asked yet
    r = client.post("/session/evaluate", json={"session_id": s["session_id"], "question_id": other, "answer": "x"})
    assert r.status_code == 404 and "not asked" in r.json()["detail"]
    assert client.post("/session/next", json={"session_id": "nope"}).status_code == 404
    assert client.post("/session/end", json={"session_id": "nope"}).status_code == 404


def test_resubmit_replaces_old_answer_and_identical_resubmit_is_idempotent(client):
    s = start(client)
    sid, q = s["session_id"], s["question"]
    assert answer(client, sid, q, good=False).json()["score"] == 0
    again = answer(client, sid, q, good=False).json()
    assert again["attempt_number"] == 1                   # identical text: nothing re-scored
    better = answer(client, sid, q, good=True).json()
    assert better["score"] == 100 and better["attempt_number"] == 2
    client.post("/session/end", json={"session_id": sid})
    report = client.get(f"/session/{sid}/report").json()
    assert report["questions_attempted"] == 1 and report["average_score"] == 100


def test_adaptive_difficulty_goes_up_after_two_strong_answers(client):
    s = start(client)
    sid, q = s["session_id"], s["question"]
    assert q["difficulty"] == "Medium"
    answer(client, sid, q, good=True)
    n1 = client.post("/session/next", json={"session_id": sid}).json()
    assert n1["question"]["difficulty"] == "Medium"       # only one answer so far -> stays
    answer(client, sid, n1["question"], good=True)
    n2 = client.post("/session/next", json={"session_id": sid}).json()
    assert n2["question"]["difficulty"] == "Hard"
    assert "moves to Hard" in n2["reason"]


def test_adaptive_follow_up_after_poor_answer(client):
    s = start(client)
    sid, q = s["session_id"], s["question"]
    answer(client, sid, q, good=False)
    n = client.post("/session/next", json={"session_id": sid}).json()
    assert n["question"]["topic"] == q["topic"]           # same-topic follow-up
    assert n["question"]["difficulty"] == "Easy"          # easier
    assert "Follow-up" in n["reason"]


def test_no_repeats_and_session_length_limit(client):
    s = start(client, n=9)
    sid, seen = s["session_id"], [s["question"]["id"]]
    for _ in range(8):                                     # skipping questions is allowed
        nxt = client.post("/session/next", json={"session_id": sid}).json()
        assert nxt["question"] is not None
        seen.append(nxt["question"]["id"])
    assert len(set(seen)) == 9                             # nothing repeated
    last = client.post("/session/next", json={"session_id": sid}).json()
    assert last["question"] is None and last["session_complete"] is True


def test_report_uses_real_numbers_and_end_is_idempotent(client):
    s = start(client)
    sid = s["session_id"]
    answer(client, sid, s["question"], good=True)                       # 100
    n = client.post("/session/next", json={"session_id": sid}).json()
    answer(client, sid, n["question"], good=False)                      # 0
    client.post("/session/next", json={"session_id": sid})              # served but skipped

    assert client.get(f"/session/{sid}/report").status_code == 409      # not finished yet
    r = client.post("/session/end", json={"session_id": sid})
    assert r.status_code == 200
    rep = r.json()
    assert rep["questions_served"] == 3 and rep["questions_attempted"] == 2
    assert rep["questions_skipped"] == 1
    assert rep["average_score"] == 50.0 and rep["overall_rating"] == "Satisfactory"
    assert len(rep["difficulty_history"]) == 3 and rep["most_missed_concepts"]
    assert rep["topic_performance"] and rep["revision_topics"]
    assert client.post("/session/end", json={"session_id": sid}).json() == rep
    assert client.get(f"/session/{sid}/report").json() == rep


def test_completed_session_cannot_continue(client):
    s = start(client)
    sid = s["session_id"]
    client.post("/session/end", json={"session_id": sid})
    assert client.post("/session/next", json={"session_id": sid}).status_code == 409
    assert answer(client, sid, s["question"]).status_code == 409
    rep = client.get(f"/session/{sid}/report").json()
    assert rep["average_score"] is None and rep["overall_rating"] is None   # nothing fabricated
